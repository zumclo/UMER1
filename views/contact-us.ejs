<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Need To Reach us?</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/whyus.css">
    <script src="https://unpkg.com/scrollreveal"></script>
</head>
<body>
 <%- include('partials/nav') %>
    <section class="contact-section">
        <h2 class="contact-title">Need To Reach us?</h2>
        
        <div class="contact-container">
            
            <div class="contact-info reveal-left">
                
                <div class="info-item">
                    <div class="icon-wrapper">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="info-text">
                        <h3>General Information:</h3>
                        <p><a href="mailto:info@Wuzwearindustry.com">info@Wuzwearindustry.com</a></p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="icon-wrapper">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="info-text">
                        <h3>Sales Department:</h3>
                        <p><a href="mailto:sales@Wuzwearindustry.com">sales@Wuzwearindustry.com</a></p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="icon-wrapper">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="info-text">
                        <h3>Support Department:</h3>
                        <p><a href="mailto:support@Wuzwearindustry.com">support@Wuzwearindustry.com</a></p>
                    </div>
                </div>

            </div>

            <div class="contact-form-container reveal-right">
                <form id="contactForm" action="#" method="POST" enctype="multipart/form-data">
                    
                    <div class="form-group">
                        <label for="name">Your name</label>
                        <input type="text" id="name" name="name" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Your email</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="form-group">
                        <label for="subject">Subject</label>
                        <input type="text" id="subject" name="subject" required>
                    </div>

                    <div class="form-group">
                        <label for="message">Your message (optional)</label>
                        <textarea id="message" name="message" rows="8"></textarea>
                    </div>

                    <div class="form-group file-input-wrapper">
                        <label for="file">Choose a file</label>
                        <input type="file" id="file" name="file">
                    </div>

                    <button type="submit" class="submit-btn">SUBMIT</button>
                </form>
            </div>

        </div>
    </section>

    <script src="../js/contact-us.js"></script>
</body>
</html>
<%- include('partials/footer') %>