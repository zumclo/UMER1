<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Error</title>
    <style>
        body { font-family: sans-serif; padding: 50px; background: #fafafa; color: #333; }
        pre { background: #eee; padding: 15px; border-radius: 4px; overflow-x: auto; }
    </style>
</head>
<body>
    <h1>Server Error (<%= error.status || 500 %>)</h1>
    <h2><%= message %></h2>
    <% if (error.stack) { %>
        <pre><%= error.stack %></pre>
    <% } %>
</body>
</html>