                <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=600&auto=format&fit=crop" alt="Quality Apparel Manufacturer">
            </div>
            <div class="card-content">
                <h2 class="card-title">Quality Apparel Manufacturer</h2>
                <div class="green-divider"></div>
