<script>
    document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.querySelector('.fab-mobile-toggle');
        const navbar = document.getElementById('fabNavbar');

        // Main Mobile Navigation Drawer Trigger Engine
        if (toggleBtn && navbar) {
            toggleBtn.addEventListener('click', (e) => {
                e.stopPropagation(); // Stops immediate event bubble confusion
                const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
                toggleBtn.setAttribute('aria-expanded', !isExpanded);
                toggleBtn.classList.toggle('is-active');
                navbar.classList.toggle('is-open');
            });
        }

        // Inner Dropdowns Sub-Menu Trigger Engine (Fixes syntax typo)
        const droplinks = document.querySelectorAll('.fab-has-dropdown > .fab-menu-link');
        
        droplinks.forEach(link => {
            link.addEventListener('click', (e) => {
                if (window.innerWidth <= 992) {
                    e.preventDefault(); 
                    e.stopPropagation();
                    const targetDropdown = link.nextElementSibling;
                    
                    if (targetDropdown) {
                        targetDropdown.classList.toggle('is-open');
                        link.classList.toggle('arrow-rotated');
                    }
                }
            });
        });
    });
</script>