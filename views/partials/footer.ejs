<script>document.addEventListener('DOMContentLoaded', () => {
    // 1. Dynamic Security Shielding for Outer Channels
    const footerSocials = document.querySelectorAll('.fab-social-links a');
    
    footerSocials.forEach(link => {
        // Enforce secure cross-origin standarding if target tags exist pointing outward
        if (link.getAttribute('target') === '_blank') {
            link.setAttribute('rel', 'noopener noreferrer');
        }
    });

    // 2. Click Logging Analytics hook placeholder
    const paymentBadges = document.querySelectorAll('.fab-pay-circle');
    paymentBadges.forEach(badge => {
        badge.addEventListener('click', () => {
            const gatewayName = badge.querySelector('img')?.getAttribute('alt') || 'Unknown';
            console.log(`User requested accepted method documentation: ${gatewayName}`);
        });
    });
});
</script>
