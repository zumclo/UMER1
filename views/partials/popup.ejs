<style>/* Reset & Base Styles for Popup Context */
.popup-overlay * {
  box-sizing: border-box;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

/* Overlay Background */
.popup-overlay {
  display: none; /* Hidden by default */
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  justify-content: center;
  align-items: center;
  padding: 15px;
}

/* Active State to Show Popup */
.popup-overlay.active {
  display: flex;
}

/* Popup Window Container */
.popup-content {
  background-color: #ffffff;
  width: 100%;
  max-width: 500px;
  border-radius: 4px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  animation: fadeIn 0.3s ease;
}

/* Green Header */
.popup-header {
  background-color: #0fa44a; /* Precise green matching your image */
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 20px;
}

.popup-header h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* Close button (X) */
.close-btn {
  background: none;
  border: none;
  color: white;
  font-size: 28px;
  cursor: pointer;
  line-height: 1;
  padding: 0;
}

/* Form Styling */
.popup-form {
  padding: 25px 20px;
}

.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  color: #666666;
  font-size: 15px;
  margin-bottom: 6px;
}

.form-group label .optional {
  color: #888888;
}

/* Inputs and Textarea */
.popup-form input[type="text"],
.popup-form input[type="email"],
.popup-form textarea {
  width: 100%;
  padding: 10px;
  border: 1px solid #dcdcdc;
  border-radius: 3px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s;
}

.popup-form input:focus,
.popup-form textarea:focus {
  border-color: #0fa44a;
}

/* Textarea resize handle mimic */
.popup-form textarea {
  resize: vertical;
  min-height: 120px;
}

/* File Input layout */
.file-group input[type="file"] {
  display: block;
  margin-top: 5px;
  font-size: 14px;
  color: #555;
}

/* Submit Button */
.submit-btn {
  background-color: #0fa44a;
  color: white;
  border: none;
  padding: 12px 30px;
  font-size: 15px;
  font-weight: bold;
  border-radius: 3px;
  cursor: pointer;
  transition: background-color 0.2s;
  text-transform: uppercase;
}

.submit-btn:hover {
  background-color: #0c853c;
}

/* Animation */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}</style> 


<div id="quotePopupOverlay" class="popup-overlay">
  <div class="popup-content">
    
    <div class="popup-header">
      <h2>Get a Qoute</h2>
      <button id="closePopupBtn" class="close-btn">&times;</button>
    </div>

    <form id="quoteForm" class="popup-form">
      <div class="form-group">
        <label for="userName">Your name</label>
        <input type="text" id="userName" name="name" required>
      </div>

      <div class="form-group">
        <label for="userEmail">Your email</label>
        <input type="email" id="userEmail" name="email" required>
      </div>

      <div class="form-group">
        <label for="formSubject">Subject</label>
        <input type="text" id="formSubject" name="subject" required>
      </div>

      <div class="form-group">
        <label for="userMessage">Your message <span class="optional">(optional)</span></label>
        <textarea id="userMessage" name="message" rows="6"></textarea>
      </div>

      <div class="form-group file-group">
        <label for="fileUpload">Choose a file</label>
        <input type="file" id="fileUpload" name="attachment">
      </div>

      <button type="submit" class="submit-btn">SUBMIT</button>
    </form>

  </div>
</div>
<script>document.addEventListener('DOMContentLoaded', () => {
  // Grab elements via unique IDs
  const popupOverlay = document.getElementById('quotePopupOverlay');
  const closePopupBtn = document.getElementById('closePopupBtn');
  const quoteForm = document.getElementById('quoteForm');
  
  // Select all trigger buttons across the site
  const triggerButtons = document.querySelectorAll('.trigger-popup-btn');

  // Open popup function
  const openPopup = () => {
    popupOverlay.classList.add('active');
    document.body.style.overflow = 'hidden'; // Prevents background scrolling
  };

  // Close popup function
  const closePopup = () => {
    popupOverlay.classList.remove('active');
    document.body.style.overflow = ''; // Restores background scrolling
  };

  // Attach event listeners to all matching buttons
  triggerButtons.forEach(button => {
    button.addEventListener('click', openPopup);
  });

  // Close popup when clicking the "X" button
  closePopupBtn.addEventListener('click', closePopup);

  // Close popup if clicking outside the main white content box
  popupOverlay.addEventListener('click', (event) => {
    if (event.target === popupOverlay) {
      closePopup();
    }
  });

  // Handle Form Submission
  quoteForm.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Process form data here (e.g., using FormData API or fetch)
    console.log("Form submitted successfully!");
    
    // Optional: Reset form and close window after submission
    quoteForm.reset();
    closePopup();
  });
});</script>