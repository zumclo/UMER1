<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>portfolio</title>
    <link rel="stylesheet" href="../css/polos.css">
    <link rel="stylesheet" href="../css/extra.css">
    <link rel="stylesheet" href="../css/portfolio.css">
</head>
<body>
    <%- include('partials/nav') %>
    <section class="hero-section">
        <div class="hero-bg-container">
            <img src="/photos/portfolio.jpg" alt="Vito and Will folded polo shirts" class="hero-image">
        </div>

    </section>
    <section class="fab-portfolio-section">
    <div class="fab-portfolio-container">
        
        <!-- Header Section -->
        <div class="fab-portfolio-header">
            <h2 class="fab-portfolio-title">Portfolio</h2>
            <p class="fab-portfolio-subtitle">These are the products that we have manufactured from the scratch for our customers.</p>
        </div>

        <!-- 4-Column Image Grid -->
        <div class="fab-portfolio-grid">
            
            <!-- Row 1 -->
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio2.jpeg" alt="Yellow Hoodie Model">
            </div>
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio3.jpeg" alt="Fitness Apparel Models">
            </div>
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio8.jpeg" alt="Floating Denim Jacket">
            </div>
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio1.jpeg" alt="Red Beanie Hat in Snow">
            </div>

            <!-- Row 2 -->
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio4.jpeg" alt="Hanging Custom T-Shirts">
            </div>
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio5.jpeg" alt="Industrial Workwear Uniform">
            </div>
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio6.jpeg" alt="Women's Yellow and Green Fitness Set">
            </div>
            <div class="fab-portfolio-item">
                <img src="/photos/portfolio7.jpeg" alt="Blue Fabric Printed Hoodie">
            </div>

            <!-- Row 3 -->
            <div class="fab-portfolio-item">
                <img src="path-to-your-images/grey-hoodie.jpg" alt="Grey Custom Manufactured Hoodie">
            </div>
            <div class="fab-portfolio-item">
                <img src="path-to-your-images/purple-puffer.jpg" alt="Purple Puffer Jacket">
            </div>
            <div class="fab-portfolio-item">
                <img src="path-to-your-images/white-sweatshirt.jpg" alt="White Fabuluxe Sweatshirt">
            </div>
            <div class="fab-portfolio-item">
                <img src="path-to-your-images/yellow-puffer.jpg" alt="Yellow Puffer Jacket">
            </div>

        </div>
    </div>
</section>
</body>
</html>
<%- include('partials/footer') %>